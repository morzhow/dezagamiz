{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dezagamiz: Start Dev Server (Port 3000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "dezagamiz: Open App in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src"
    }
  ],
  "compounds": [
    {
      "name": "dezagamiz: Server + Browser",
      "configurations": [
        "dezagamiz: Start Dev Server (Port 3000)",
        "dezagamiz: Open App in Chrome"
      ]
    }
  ]
}
